CROWSNEST_HTTP_ADDR=:8080
CROWSNEST_DB_PATH=data/crowsnest.sqlite3
CROWSNEST_DRY_RUN=true
CROWSNEST_RECONCILE_DRY_RUN=true
CROWSNEST_DELIVERY_POLL_INTERVAL=2s
CROWSNEST_RECONCILE_INTERVAL=15m
CROWSNEST_IDENTITY_SYNC_ENABLED=false
CROWSNEST_IDENTITY_SYNC_DRY_RUN=true
CROWSNEST_IDENTITY_SYNC_INTERVAL=1h
CROWSNEST_ALLOWED_EMAIL_DOMAINS=example.com

# Identity sync requires the Feishu app permission contact:user.id:readonly.

# GitLab Webhook and Hook Reconciler
# CROWSNEST_WEBHOOK_SECRET=
# CROWSNEST_GITLAB_BASE_URL=https://gitlab.example.com
# CROWSNEST_GITLAB_API_TOKEN=
# CROWSNEST_GITLAB_WEBHOOK_URL=http://host.example:5680/webhook/gitlab
# CROWSNEST_GITLAB_WEBHOOK_TOKEN=
# CROWSNEST_GITLAB_HOOK_TOKEN=
# CROWSNEST_GITLAB_HOOK_NAME=Crowsnest
# CROWSNEST_GITLAB_SSL_VERIFY=true

# Feishu Self-Built App Bot
# CROWSNEST_FEISHU_BASE_URL=https://open.feishu.cn
# CROWSNEST_FEISHU_APP_ID=
# CROWSNEST_FEISHU_APP_SECRET=
